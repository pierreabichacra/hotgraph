# Template only — never put real values in this file, it is NOT gitignored.
# Copy to .env (which is gitignored) and fill that in instead.
#
# Get these from https://my.telegram.org -> API development tools.
# These are your own account's API credentials. Creating a second session with
# them does NOT disturb your existing oiltraderbot session.
TG_API_ID=
TG_API_HASH=

# Optional: only needed if your account has 2FA enabled and you'd rather not
# type the password interactively during tg_login.
# TG_PASSWORD=
